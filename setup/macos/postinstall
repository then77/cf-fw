#!/bin/sh
set -eu

target_volume=${3:-/}
config_dir="${target_volume%/}/usr/local/lib/fw/cf"
install_user=${SUDO_USER:-}

if [ -z "$install_user" ] || [ "$install_user" = 'root' ]; then
    install_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
fi

case $install_user in
    ''|root|loginwindow)
        echo 'FW installed, but no interactive user was available to own its configuration directory.' >&2
        exit 0
        ;;
esac

install_group=$(/usr/bin/id -gn "$install_user")
/usr/bin/install -d -m 0700 -o "$install_user" -g "$install_group" "$config_dir"
